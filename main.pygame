#!/usr/bin/env python3
"""Batocera entry point for launching the game from a Git checkout."""

from __future__ import annotations

import sys
from pathlib import Path

BATOCERA_ENTRYPOINT_DIR = (
    Path(__file__).resolve().parent / "packaging" / "batocera" / "pygame"
)
sys.path.insert(0, str(BATOCERA_ENTRYPOINT_DIR))

from main import main

raise SystemExit(main())
